using RitsuLib;
using yyl_sts2_mod.Code.Extensions;

namespace yyl_sts2_mod.Code.Abstract;

/// <summary>
///     RitsuLib 版本的卡牌抽象基类。
///     <para>
///         老的 <see cref="yylCardModel" /> 走 BaseLib; 新加的卡走这里(继承 <c>ModCardTemplate</c>)。
///         路径与命名约定保持与 yylCardModel 一致(图片按 <c>Id.Entry</c> 小写解析)。
///     </para>
///     <para>
///         RitsuLib 的卡牌 ID 格式是 <c>{ModId}_{category}_{name}</c>; 本 mod 的实例化 ID 形如
///         <c>YYL_STS2_MOD_CARD_TU_NA</c>(与 BaseLib 的 <c>YYL_STS2_MOD-TU_NA</c> 不同)。
///     </para>
/// </summary>
[ModCardType("CARD", IdPrefix = "YYL_STS2_MOD_")]
public abstract class yylRitsuCard(int canonicalEnergyCost, CardType type, CardRarity rarity, TargetType targetType)
    : ModCardTemplate(canonicalEnergyCost, type, rarity, targetType)
{
    public override string CustomPortraitPath => $"{Id.Entry.RemovePrefix().ToLowerInvariant()}.png".BigCardImagePath();
    public override string PortraitPath => $"{Id.Entry.RemovePrefix().ToLowerInvariant()}.png".CardImagePath();
    public override string BetaPortraitPath => $"beta/{Id.Entry.RemovePrefix().ToLowerInvariant()}.png".CardImagePath();
}
