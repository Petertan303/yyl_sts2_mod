{
  "DARV.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.ancient": "……你找什么呢？",
  "DARV.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.next": "回应",
  "DARV.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.char": "[sine]有看到某个黄色生物吗？[/sine]",
  "DARV.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.next": "继续",
  "DARV.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-2.ancient": "哈，没有！但是我听说塔顶的那位全身覆盖着黄色的盔甲。",
  "DARV.talk.YYL_STS2_MOD-YYL_STS2_MOD.1-0r.ancient": "最近帮你盯着呢！没有黄色生物从这里路过。",
  "DARV.talk.YYL_STS2_MOD-YYL_STS2_MOD.1-1r.next": "感谢",
  "DARV.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.ancient": "有好东西，要看看吗？能把你的心魔砍得稀巴烂。",
  "DARV.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.next": "回应",
  "DARV.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.char": "[sine]……谢谢你。[/sine]",
  "DARV.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.next": "继续",
  "DARV.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-2r.ancient": "啊呀，别乱翻！他不在这里面！",
  "NEOW.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.ancient": "[sine]...黄色...生物...？[/sine]",
  "NEOW.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.next": "继续",
  "NEOW.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.char": "[sine]是的。你有见到吗？[/sine]",
  "NEOW.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.next": "继续",
  "NEOW.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-2.ancient": "[sine]...没有...不...[red][jitter]建筑师[/jitter][/red]..\n...你要找的存在...名为[red][jitter]建筑师[/jitter][/red][/sine]",
  "NEOW.talk.YYL_STS2_MOD-YYL_STS2_MOD.1-0r.ancient": "[sine]....有...收获吗...？[/sine]",
  "NEOW.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.ancient": "[sine]..你.. 到底...从何而来...[/sine]",
  "NEOW.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.next": "回答",
  "NEOW.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.char": "[sine]我自东土大唐而来，前往西天取经。[/sine]",
  "NEOW.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.next": "继续",
  "NEOW.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-2r.ancient": "[sine]...哈...原来...\n...想当年...[/sine]",
  "NONUPEIPE.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.ancient": "东方来的小家伙？\n黄色生物在塔顶等待。接受我的赐福吧。",
  "NONUPEIPE.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.next": "上前",
  "NONUPEIPE.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.char": "[sine]谢谢大姐您嘞。[/sine]",
  "NONUPEIPE.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.next": "继续",
  "NONUPEIPE.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-2.ancient": "哈哈。很少有人如此称呼我了……",
  "NONUPEIPE.talk.YYL_STS2_MOD-YYL_STS2_MOD.1-0r.ancient": "回来了？来选吧，希望这些能让你这次顺利些。",
  "NONUPEIPE.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.ancient": "你追寻的，和我追寻的，本质是相同的。",
  "NONUPEIPE.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.next": "疑问",
  "NONUPEIPE.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.char": "[sine]此话[/sine]，[jitter]怎讲[/jitter]？",
  "NONUPEIPE.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.next": "继续",
  "NONUPEIPE.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-2r.ancient": "你会明白的。但在那之前，先打倒塔顶的疯狂。",
  "OROBAS.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.ancient": "黄！色！生！物！",
  "OROBAS.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.next": "回应",
  "OROBAS.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.char": "[sine]是的。你看见过他吗？[/sine]",
  "OROBAS.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.next": "继续",
  "OROBAS.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-2.ancient": "没有！！没有！！但是有亮闪闪的！你看！！",
  "OROBAS.talk.YYL_STS2_MOD-YYL_STS2_MOD.1-0r.ancient": "放轻松！！放轻松！！来点好东西！！",
  "OROBAS.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.ancient": "找到之后……要做什么？暴力不好！！",
  "OROBAS.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.next": "回答",
  "OROBAS.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.char": "[jitter]我和他的纠葛，不是暴力可以化解的。[/jitter]\n[sine]这是宿命的一部分。[/sine]",
  "OROBAS.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.next": "继续",
  "OROBAS.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-2r.ancient": "呃！好复杂！！有欧洛巴斯能帮上忙的吗？？",
  "PAEL.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.char": "[sine]奶龙！……不，等等，这不一样。[/sine]",
  "PAEL.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.next": "回答",
  "PAEL.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.ancient": "[thinky_dots]安静点。是黏土。黏土龙佩尔。[/thinky_dots]",
  "PAEL.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.next": "思考",
  "PAEL.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-2.char": "[sine]黏土龙……[/sine]",
  "PAEL.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-2.next": "继续",
  "PAEL.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-3.ancient": "[thinky_dots]嗯。带上我的一部分吧……[/thinky_dots]",
  "PAEL.talk.YYL_STS2_MOD-YYL_STS2_MOD.1-0r.ancient": "[thinky_dots]……父亲……[/thinky_dots]",
  "PAEL.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.ancient": "[thinky_dots]父亲……？[/thinky_dots]",
  "PAEL.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.next": "不回应",
  "PAEL.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.char": "[sine]（假装没有听见）[/sine]",
  "PAEL.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.next": "继续",
  "PAEL.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-2r.ancient": "[thinky_dots]……很相似……但不一样。嗯……奇怪……[/thinky_dots]",
  "TANX.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.ancient": "[b]武器！！武器在哪里！！[/b]",
  "TANX.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.next": "回答",
  "TANX.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.char": "[jitter]我的炁是最锋利的矛、最坚固的盾。[/jitter]",
  "TANX.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.next": "展示",
  "TANX.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-2.ancient": "[b]火烧起来了！雷电？！很强大的武器，我喜欢！！[/b]",
  "TANX.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-2.char": "（伊林展示了异人功法）",
  "TANX.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-2.next": "继续",
  "TANX.talk.YYL_STS2_MOD-YYL_STS2_MOD.1-0r.ancient": "[b]使炁的小弟，挑件正经的武器吧！！[/b]",
  "TANX.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.ancient": "[b]伊林，与我一战！！[/b]",
  "TANX.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.next": "战斗",
  "TANX.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.char": "（伊林用掌心雷烧焦了坦克斯的胡子）",
  "TANX.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.next": "继续",
  "TANX.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-2r.ancient": "[b]好啊！！[/b]",
  "TEZCATARA.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.ancient": "亲爱的，你心底的[jitter][b]火[/b][/jitter]简直要把我吞没了。",
  "TEZCATARA.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.next": "？",
  "TEZCATARA.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.char": "[sine]你看见过黄色生物吗？[/sine]",
  "TEZCATARA.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.next": "继续",
  "TEZCATARA.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-2.ancient": "如果我是你在找的那个人，八百里远就能看到你心底的[jitter][b]火[/b][/jitter]逃之夭夭了，亲爱的。",
  "TEZCATARA.talk.YYL_STS2_MOD-YYL_STS2_MOD.1-0r.ancient": "最好还是控制一下[jitter][b]你的心[/b][/jitter]哦。你那[jitter][b]炽热的心[/b][/jitter]。",
  "TEZCATARA.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.ancient": "[jitter][b]熊熊燃烧[/b][/jitter]的欲望、执着，还有仇恨……",
  "TEZCATARA.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.next": "打断",
  "TEZCATARA.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.char": "[sine]请您[jitter]不要再说了[/jitter]。[/sine]",
  "TEZCATARA.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.next": "继续",
  "TEZCATARA.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-2r.ancient": "哦哦……老眼昏花的我看走眼了。远远不止。[jitter][b]远远不止[/b][/jitter]……",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0r.char": "[sine]我追随黄色生物的踪迹。[/sine]",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0r.next": "继续",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1r.ancient": "黄色生物……？",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1r.next": "思索",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-2r.char": "[jitter]你……是黄色的。[/jitter]",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-attack": "Both",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.1-0r.ancient": "我不是你要找的人。",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.1-0r.next": "质疑",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.1-1r.char": "[sine]不，你是！[/sine]",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.1-1r.next": "继续",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.1-2r.ancient": "我不是的……",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.ancient": "其实，我认识你口中的那个人。",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.next": "回答",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.char": "[jitter]已经晚了。你与他一样，都是我的敌人！[/jitter]",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.next": "继续",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-2r.char": "[jitter][red]呵啊！[/red][/jitter]",
  "THE_ARCHITECT.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-attack": "Both",
  "VAKUU.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.ancient": "某个被遗忘之神的信徒么？我能提供[sine]更好[/sine]的信仰哦。",
  "VAKUU.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-0.next": "攻击",
  "VAKUU.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.char": "[sine]啊呀,奶龙！！/sine]",
  "VAKUU.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-1.next": "继续",
  "VAKUU.talk.YYL_STS2_MOD-YYL_STS2_MOD.0-2.ancient": "我的脸！你在发什么疯！！",
  "VAKUU.talk.YYL_STS2_MOD-YYL_STS2_MOD.1-0r.ancient": "别靠近我，我警告你。",
  "VAKUU.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.ancient": "你到底为何对[sine]黄色生物[/sine]如此执着？",
  "VAKUU.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-0r.next": "回答",
  "VAKUU.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.char": "[jitter]你不会明白的。[/jitter]\n[sine]你不会明白的。[/sine]",
  "VAKUU.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-1r.next": "继续",
  "VAKUU.talk.YYL_STS2_MOD-YYL_STS2_MOD.2-2r.ancient": "[i][font_size=22][sine]真无趣。[/sine][/font_size][/i]\n唉，离我远点。"
}